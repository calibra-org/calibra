{
    "name": "@calibra/monorepo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.32.1",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "dev:web": "turbo run dev --filter=@calibra/web",
        "dev:admin": "turbo run dev --filter=@calibra/admin",
        "dev:platform": "turbo run dev --filter=@calibra/platform",
        "dev:api": "turbo run dev --filter=@calibra/api",
        "format": "oxfmt --check",
        "format:fix": "oxfmt",
        "lint": "pnpm run lint:oxlint && pnpm run lint:ws",
        "lint:fix": "pnpm run lint:oxlint:fix",
        "lint:oxlint": "oxlint",
        "lint:oxlint:fix": "oxlint --fix",
        "lint:ws": "pnpm dlx sherif@latest --ignore-rule root-package-dependencies",
        "lint:ws:fix": "pnpm dlx sherif@latest --fix",
        "spin": "node scripts/spin.mjs",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck"
    },
    "devDependencies": {
        "@playwright/test": "catalog:",
        "@types/node": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "tsdown": "catalog:",
        "turbo": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@tailwindcss/oxide",
            "msw",
            "sharp",
            "unrs-resolver"
        ],
        "ignoredBuiltDependencies": [
            "core-js",
            "protobufjs"
        ]
    }
}
