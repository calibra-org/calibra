{
    "cSpell.words": ["nuqs", "oxfmt", "oxlint", "tsdown", "Vazirmatn", "woocommerce"],
    "[jsonc]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[javascript]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "editor.codeActionsOnSave": {
        "source.fixAll.oxc": "explicit"
    },
    "oxc.fmt.experimental.enable": true,
    "files.associations": {
        "*-lock.yaml": "yaml",
        "pnpm-lock.yaml": "yaml"
    }
}
